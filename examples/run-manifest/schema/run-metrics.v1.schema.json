                "run_aborted_before_window"
              ]
            },
            "censored_lower_bound": {
              "type": "number",
              "minimum": 0
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          }
        },
        "buffer_starvation_fraction": {
          "type": "object",
          "required": [
            "status",
            "value",
            "unit"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "not_computable",
                "not_applicable"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "unit": {
              "const": "fraction"
            },
            "reason": {
              "type": "string",
              "enum": [
                "clock_unsynchronized",
                "no_samples",
                "run_aborted_before_window"
              ]
            },
            "censored_lower_bound": {
              "type": "number",
